<h1>Painel de Gestão</h1>
<p>Bem-vinda, Neid!</p>

<hr>

<div style="margin-bottom: 2rem;">
  <%= link_to 'Gerenciar Produtos', admin_produtos_path, style: 'font-size: 1.1em; padding: 10px 15px; background: #e91e63; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;' %>

  <%= link_to 'Gerenciar Eventos', admin_eventos_path, style: 'font-size: 1.1em; padding: 10px 15px; background: #e91e63; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;' %>

  <%= link_to 'Gerenciar Usuários', admin_usuarios_path, style: 'font-size: 1.1em; padding: 10px 15px; background: #e91e63; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;' %>

  <%= link_to 'Gerenciar Pedidos', admin_pedidos_path, style: 'font-size: 1.1em; padding: 10px 15px; background: #e91e63; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;' %>

  <%= link_to 'Gerenciar Promoções', admin_promocoes_path, style: 'font-size: 1.1em; padding: 10px 15px; background: #e91e63; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;' %>
</div>

<h2>Métricas Principais</h2>

<div style="display: flex; gap: 20px; margin-bottom: 30px;">
  <div style="border: 1px solid #ddd; padding: 20px; border-radius: 8px; flex: 1; text-align: center;">
    <h3 style="margin: 0; color: #666;">Total de Pedidos</h3>
    <p style="font-size: 2em; font-weight: bold; margin: 10px 0;"><%= @total_pedidos %></p>
  </div>

  <div style="border: 1px solid #ddd; padding: 20px; border-radius: 8px; flex: 1; text-align: center;">
    <h3 style="margin: 0; color: #666;">Faturamento Total</h3>
    <p style="font-size: 2em; font-weight: bold; margin: 10px 0; color: #2ecc71;">
      <%= number_to_currency(@faturamento_total, unit: "R$ ", separator: ",", delimiter: ".") %>
    </p>
  </div>
</div>

<hr>

<div style="display: flex; gap: 40px; margin-top: 20px;">
  
  <div style="flex: 1;">
    <h3>Último Pedido Recebido</h3>
    <% if @ultimo_pedido %>
      <div style="background: #f9f9f9; padding: 15px; border-radius: 5px;">
        <p><strong>Número:</strong> #<%= @ultimo_pedido.id %></p>
        <p><strong>Data:</strong> <%= @ultimo_pedido.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
        <p><strong>Valor:</strong> <%= number_to_currency(@ultimo_pedido.total, unit: "R$ ", separator: ",", delimiter: ".") %></p>
        <%= link_to "Ver Detalhes", admin_pedido_path(@ultimo_pedido), style: "color: #e91e63; text-decoration: none;" %>
      </div>
    <% else %>
      <p>Nenhum pedido realizado ainda.</p>
    <% end %>
  </div>

  <div style="flex: 1;">
    <h3>Produtos Mais Vendidos</h3>
    <% if @produtos_mais_vendidos.any? %>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="text-align: left; border-bottom: 1px solid #ccc;">
            <th style="padding: 8px;">Produto</th>
            <th style="padding: 8px;">Vendas (Qtd)</th>
          </tr>
        </thead>
        <tbody>
          <% @produtos_mais_vendidos.first(5).each do |nome, quantidade| %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 8px;"><%= nome %></td>
              <td style="padding: 8px; font-weight: bold;"><%= quantidade %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>Ainda não há dados de vendas.</p>
    <% end %>
  </div>

</div>