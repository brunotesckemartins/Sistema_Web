<!DOCTYPE html>
<html>
<head>
  <title>AlfajorWeb</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= vite_client_tag %>
  <%= vite_javascript_tag 'application.jsx' %>

  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/milligram@1.4.1/dist/milligram.min.css">
</head>

<body>

<nav class="navbar">
  <div class="logo">
    <span class="logo-black">Doces da</span>
    <span class="logo-pink">Neid</span>
  </div>

  <div class="hamburger" id="hamburger-button" role="button" aria-label="Menu" tabindex="0">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <ul class="nav-links" id="nav-links-menu">
    <li><%= link_to 'Home', root_path %></li>
    <li><%= link_to 'Cestinha', carrinho_path %></li>

    <% if current_usuario && current_usuario.admin? %>
      <li><%= link_to "Dashboard Admin", admin_dashboard_path %></li>
    <% end %>

    <% if usuario_signed_in? %>
      <li><%= link_to 'Meu Perfil', perfil_path, style: "font-weight: bold; color: #e91e63;" %></li>

      <li class="btn-encomendar"><%= button_to "Sair", destroy_usuario_session_path, method: :delete %></li>
    <% else %>
      <li class="btn-encomendar"><%= link_to 'Entrar', new_usuario_session_path %></li>
    <% end %>
  </ul>
</nav>

<%= yield %>

</body>
</html>