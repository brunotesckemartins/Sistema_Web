<!DOCTYPE html>
<html>
<head>
  <title>AlfajorWeb</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= vite_client_tag %>
  <%= vite_javascript_tag 'application.jsx' %>

  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/milligram@1.4.1/dist/milligram.min.css">
</head>

<body>
<header>
  <nav>
    <%= link_to 'Home', root_path %> |
    <%= link_to 'Ver Seu Carrinho', carrinho_path %> |
    <%= link_to 'Ver Eventos', eventos_path %> |
    <%= link_to 'Produtos', produtos_path %>


    <% if usuario_signed_in? %>
      | <%= button_to "Sair", destroy_usuario_session_path, method: :delete %>
    <% else %>
      | <%= link_to 'Entrar', new_usuario_session_path %>
    <% end %>
  </nav>
</header>

<%= yield %>

</body>
</html>